      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Content Placeholder</title>\n  <style>\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n\n    html, body {\n      width: 100%;\n      height: 100%;\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Inter, sans-serif;\n      background-color: #121316;\n      color: #e4e4e7;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      padding: 16px;\n      overflow: hidden;\n    }\n\n    .placeholder-box {\n      width: 100%;\n      height: 100%;\n      border: 2px dashed rgba(201, 161, 91, 0.45);\n      border-radius: 12px;\n      background: radial-gradient(circle at center, rgba(201, 161, 91, 0.06) 0%, rgba(18, 19, 22, 0.9) 100%);\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      text-align: center;\n      padding: 24px;\n      transition: all 0.25s ease;\n    }\n\n    .placeholder-box:hover {\n      border-color: #c9a15b;\n      background: radial-gradient(circle at center, rgba(201, 161, 91, 0.12) 0%, rgba(18, 19, 22, 0.95) 100%);\n    }\n\n    .icon-wrapper {\n      width: 56px;\n      height: 56px;\n      border-radius: 50%;\n      background-color: rgba(201, 161, 91, 0.12);\n      border: 1px solid rgba(201, 161, 91, 0.35);\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      margin-bottom: 16px;\n      color: #c9a15b;\n    }\n\n    h2 {\n      font-size: 1.15rem;\n      font-weight: 600;\n      letter-spacing: 0.3px;\n      margin-bottom: 8px;\n      color: #fafafa;\n    }\n\n    p {\n      font-size: 0.875rem;\n      color: #a1a1aa;\n      max-width: 340px;\n      line-height: 1.5;\n      margin-bottom: 18px;\n    }\n\n    .badges {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 8px;\n      justify-content: center;\n    }\n\n    .badge {\n      font-size: 0.72rem;\n      font-weight: 500;\n      padding: 4px 10px;\n      border-radius: 999px;\n      background-color: rgba(255, 255, 255, 0.05);\n      border: 1px solid rgba(255, 255, 255, 0.1);\n      color: #d4d4d8;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"placeholder-box\">\n    <div class=\"icon-wrapper\">\n      <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\" ry=\"2\"></rect>\n        <line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"16\"></line>\n        <line x1=\"8\" y1=\"12\" x2=\"16\" y2=\"12\"></line>\n      </svg>\n    </div>\n    <h2>Dynamic Content Area</h2>\n    <p>This space is ready to display any embedded media, interactive widget, web page, or custom content.</p>\n    <div class=\"badges\">\n      <span class=\"badge\">Webpages</span>\n      <span class=\"badge\">Video &amp; Media</span>\n      <span class=\"badge\">Forms</span>\n      <span class=\"badge\">3D / Maps</span>\n    </div>\n  </div>\n</body>\n</html>"
