      "imageUrl": "custom/1b0d59aa4cec6722.png",
      "widthM": 0.3,
      "name": "Popup 1",
      "title": "Working Hours",
      "html": "<div class=\"working-time-popup-content\">\n  <style>\n    .working-time-popup-content {\n      --bg-main: #ffffff;\n      --bg-card: #f8fafc;\n      --bg-hover: #f1f5f9;\n      --border-color: #e2e8f0;\n      --text-main: #0f172a;\n      --text-muted: #64748b;\n      --accent-blue: #2563eb;\n      --accent-blue-hover: #1d4ed8;\n      \n      /* Status Colors */\n      --status-open-bg: #f0fdf4;\n      --status-open-border: #bbf7d0;\n      --status-open-text: #15803d;\n      \n      --status-warn-bg: #fffbeb;\n      --status-warn-border: #fef3c7;\n      --status-warn-text: #b45309;\n      \n      --status-off-bg: #fff1f2;\n      --status-off-border: #fecdd3;\n      --status-off-text: #be123c;\n\n      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;\n      background-color: var(--bg-main);\n      border: 1px solid var(--border-color);\n      color: var(--text-main);\n      border-radius: 1rem;\n      padding: 1.5rem;\n      max-width: 28rem;\n      width: 100%;\n      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.01);\n      box-sizing: border-box;\n      direction: rtl;\n      text-align: right;\n      min-width: 100%;\n    }\n\n    .working-time-popup-content * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n\n    /* Header Styling */\n    .wt-header {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      width: 100%;\n      padding-bottom: 1rem;\n      margin-bottom: 1.25rem;\n      border-bottom: 1px solid var(--border-color);\n    }\n\n    .wt-header-title-group {\n      display: flex;\n      align-items: center;\n      gap: 0.75rem;\n    }\n\n    .wt-icon-wrapper {\n      padding: 0.625rem;\n      border-radius: 0.75rem;\n      background-color: #eff6ff;\n      color: var(--accent-blue);\n      border: 1px solid #dbeafe;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n\n    .wt-title {\n      font-size: 1.125rem;\n      font-weight: 700;\n      color: #0f172a;\n      line-height: 1.3;\n    }\n\n    .wt-subtitle {\n      font-size: 0.75rem;\n      color: var(--text-muted);\n      margin-top: 0.125rem;\n    }\n\n    .wt-close-btn {\n      background: transparent;\n      border: none;\n      color: var(--text-muted);\n      padding: 0.375rem;\n      border-radius: 0.5rem;\n      cursor: pointer;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      transition: background-color 0.2s, color 0.2s;\n    }\n\n    .wt-close-btn:hover {\n      background-color: var(--bg-hover);\n      color: #0f172a;\n    }\n\n    /* Status Banner */\n    .wt-status-banner {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 0.75rem;\n      margin-bottom: 1.25rem;\n      border-radius: 0.75rem;\n      background-color: var(--status-open-bg);\n      border: 1px solid var(--status-open-border);\n      color: var(--status-open-text);\n      font-size: 0.875rem;\n      font-weight: 600;\n    }\n\n    .wt-status-indicator {\n      display: flex;\n      align-items: center;\n      gap: 0.5rem;\n    }\n\n    .wt-ping-dot {\n      position: relative;\n      display: flex;\n      width: 0.625rem;\n      height: 0.625rem;\n    }\n\n    .wt-ping-ring {\n      position: absolute;\n      width: 100%;\n      height: 100%;\n      border-radius: 50%;\n      background-color: var(--status-open-text);\n      opacity: 0.75;\n      animation: wt-ping 1.5s cubic-bezier(0, 0, 0.2, 1) infinite;\n    }\n\n    .wt-ping-core {\n      position: relative;\n      width: 0.625rem;\n      height: 0.625rem;\n      border-radius: 50%;\n      background-color: var(--status-open-text);\n    }\n\n    @keyframes wt-ping {\n      75%, 100% {\n        transform: scale(2);\n        opacity: 0;\n      }\n    }\n\n    .wt-badge {\n      font-size: 0.75rem;\n      background-color: #dcfce7;\n      color: #166534;\n      padding: 0.125rem 0.625rem;\n      border-radius: 9999px;\n      font-weight: 600;\n    }\n\n    /* Schedule List */\n    .wt-schedule-list {\n      display: flex;\n      flex-direction: column;\n      gap: 0.625rem;\n      margin-bottom: 1.5rem;\n      font-size: 0.875rem;\n    }\n\n    .wt-schedule-item {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 0.75rem;\n      border-radius: 0.75rem;\n      background-color: var(--bg-card);\n      border: 1px solid var(--border-color);\n    }\n\n    .wt-day-label {\n      font-weight: 600;\n      color: #334155;\n    }\n\n    .wt-day-label.off {\n      color: var(--text-muted);\n    }\n\n    .wt-time-tag {\n      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;\n      font-size: 0.75rem;\n      font-weight: 600;\n      padding: 0.25rem 0.625rem;\n      border-radius: 0.375rem;\n      direction: ltr;\n    }\n\n    .wt-time-tag.blue {\n      color: #1d4ed8;\n      background-color: #eff6ff;\n      border: 1px solid #bfdbfe;\n    }\n\n    .wt-time-tag.amber {\n      color: var(--status-warn-text);\n      background-color: var(--status-warn-bg);\n      border: 1px solid #fde68a;\n    }\n\n    .wt-time-tag.rose {\n      font-family: inherit;\n      color: var(--status-off-text);\n      background-color: var(--status-off-bg);\n      border: 1px solid var(--status-off-border);\n    }\n\n    /* Notice Note */\n    .wt-notice {\n      font-size: 0.75rem;\n      color: var(--text-muted);\n      line-height: 1.6;\n      margin-bottom: 1.5rem;\n      background-color: #f8fafc;\n      padding: 0.75rem;\n      border-radius: 0.75rem;\n      border: 1px solid #e2e8f0;\n    }\n\n    .wt-notice-title {\n      font-weight: 600;\n      color: #334155;\n    }\n\n    /* Actions */\n    .wt-actions {\n      display: flex;\n      align-items: center;\n      gap: 0.75rem;\n    }\n\n    .wt-btn-primary {\n      flex: 1;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      gap: 0.5rem;\n      background-color: var(--accent-blue);\n      color: #ffffff;\n      font-weight: 600;\n      padding: 0.625rem 1rem;\n      border-radius: 0.75rem;\n      border: none;\n      cursor: pointer;\n      font-size: 0.875rem;\n      box-shadow: 0 4px 6px -1px rgba(37, 99, 235, 0.2);\n      transition: background-color 0.2s, transform 0.1s;\n    }\n\n    .wt-btn-primary:hover {\n      background-color: var(--accent-blue-hover);\n    }\n\n    .wt-btn-secondary {\n      padding: 0.625rem 1rem;\n      border-radius: 0.75rem;\n      border: 1px solid var(--border-color);\n      background-color: #ffffff;\n      color: #475569;\n      font-weight: 600;\n      cursor: pointer;\n      font-size: 0.875rem;\n      transition: background-color 0.2s, color 0.2s;\n    }\n\n    .wt-btn-secondary:hover {\n      background-color: var(--bg-hover);\n      color: #0f172a;\n    }\n  </style>\n\n  <!-- Real-Time Status Banner -->\n  <div class=\"wt-status-banner\">\n    <div class=\"wt-status-indicator\">\n      <span class=\"wt-ping-dot\">\n        <span class=\"wt-ping-ring\"></span>\n        <span class=\"wt-ping-core\"></span>\n      </span>\n      <span>مفتوح الآن لاستقبال طلباتكم</span>\n    </div>\n    <span class=\"wt-badge\">متاح</span>\n  </div>\n\n  <!-- Working Hours Schedule List -->\n  <div class=\"wt-schedule-list\">\n    <!-- Regular Work Days -->\n    <div class=\"wt-schedule-item\">\n      <span class=\"wt-day-label\">الأحد – الخميس</span>\n      <span class=\"wt-time-tag blue\">09:00 AM – 05:00 PM</span>\n    </div>\n\n    <!-- Saturday -->\n    <div class=\"wt-schedule-item\">\n      <span class=\"wt-day-label\">السبت</span>\n      <span class=\"wt-time-tag amber\">10:00 AM – 03:00 PM</span>\n    </div>\n\n    <!-- Friday -->\n    <div class=\"wt-schedule-item\">\n      <span class=\"wt-day-label off\">الجمعة</span>\n      <span class=\"wt-time-tag rose\">عطلة أسبوعية</span>\n    </div>\n  </div>\n\n  <!-- Notice Note -->\n  <p class=\"wt-notice\">\n    📌 <span class=\"wt-notice-title\">ملاحظة:</span> جميع الرسائل والاستفسارات الواردة خارج مواعيد العمل الرسمية يتم التعامل معها والرد عليها في أول ساعات يوم العمل التالي مباشرة.\n  </p>\n\n  <!-- Action Buttons -->\n  <div class=\"wt-actions\">\n    <button type=\"button\" class=\"wt-btn-primary\">\n      <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\">\n        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M8 10h.01M12 10h.01M16 10h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z\" />\n      </svg>\n      <span>أرسل لنا رسالة</span>\n    </button>\n   </div>\n</div>"
    }
  ],
